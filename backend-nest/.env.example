# Database
# La app conecta como `karuapp_app` (rol NOBYPASSRLS): el aislamiento por tenant
# (Fase 5) se aplica de verdad. El contexto lo pone DatabaseService con
# set_config(..., TRUE) dentro de cada transaccion, por eso se usa el Session
# pooler (puerto 5432, modo sesion), NO el transaction pooler (6543).
#
# Roles (se crean en la migracion 20261007000000_rls_tenant_isolation como
# NOLOGIN; la password se define una vez fuera del repo):
#   ALTER ROLE karuapp_app     LOGIN PASSWORD '<random>';
#   ALTER ROLE karuapp_migrate LOGIN PASSWORD '<random>';
# El backend accede con `pg` + Kysely. La zona horaria de todas las columnas
# `timestamp without time zone` se maneja en UTC a nivel driver.
DATABASE_URL="postgresql://karuapp_app.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Conexiones por instancia. Subir solo si el plan de Supabase lo permite.
DATABASE_POOL_MAX="5"
# node-pg-migrate corre fuera del pooler (puerto 5432 directo). Hoy con el rol
# `postgres` (dueno de las tablas, puede hacer DDL); BYPASSRLS para no pelear con
# las politicas al migrar.
DIRECT_DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# JWT
# Obligatorio: minimo 32 caracteres. Generar con: openssl rand -hex 32
# El backend no arranca si falta o es corto.
JWT_SECRET="change-me-to-32-plus-random-characters"
JWT_EXPIRATION="7d"

# App
PORT=3000
NODE_ENV="development"

# SMTP
# Obligatorio para registro, activacion de cuenta, reseteo de password y 2FA.
# Sin esto el backend responde 503 en esos flujos (no los simula ni los filtra).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu-cuenta@gmail.com"
SMTP_PASS="app-password-aqui"
SMTP_FROM="no-reply@karuapp.com"

# CORS
# En produccion es OBLIGATORIO (el backend no arranca sin esto).
# Lista de origenes permitidos separada por comas.
CORS_ORIGINS="https://tu-frontend.com"

# Rate limiting
# memory = contadores en el proceso (solo sirve con una instancia).
# Fase 11: migrar a redis cuando haya mas de una instancia.
RATE_LIMIT_BACKEND="memory"

# Print service
PRINT_SERVICE_URL="http://localhost:5123"
PRINT_API_TOKEN="change-me"

# Supabase Storage + Realtime
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-service-key"
# Clave publica (anon) que consume el frontend para Realtime. Es segura de exponer.
SUPABASE_ANON_KEY="your-anon-key"
# Secreto para firmar los tokens de Realtime (POST /api/auth/realtime-token).
# Dashboard Supabase -> Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Frontend URL
FRONTEND_URL="http://localhost:5173"
