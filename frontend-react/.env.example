# Frontend (Vite)
# URL base del backend. Si se deja vacío, el frontend usa su propio origen
# (en Vercel, vercel.json redirige /api/* a https://karuapp-api.vercel.app).
# Ej: http://localhost:3000 en dev, https://karuapp-api.vercel.app en prod.
VITE_API_URL=http://localhost:3000

# Supabase Realtime (el frontend se suscribe al canal `restaurante:<id>`).
# Ambos son publicos (anon key), es seguro que viajen en el bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key