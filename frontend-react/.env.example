# Frontend (Vite)
# URL base del backend. Ej: http://localhost:3000 en dev, https://api.tudominio.com en prod.
VITE_API_URL=http://localhost:3000

# Supabase Realtime (el frontend se suscribe al canal `restaurante:<id>`).
# Ambos son publicos (anon key), es seguro que viajen en el bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key